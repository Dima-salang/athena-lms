# Athena LMS - Next.js Edition

# ─── DATABASE ───────────────────────────────────────────────────────────────
# SQLite (development default — mirrors current H2 behavior)
DATABASE_URL="file:./prisma/athena.db"

# PostgreSQL (production — uncomment and set your connection string)
# DATABASE_URL="postgresql://user:password@localhost:5432/athenalms"

# ─── BETTER AUTH ────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="REPLACE_WITH_A_STRONG_64_CHAR_HEX_SECRET"
BETTER_AUTH_URL="http://localhost:3000"

# ─── NEXT.JS ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# ─── SECURITY ───────────────────────────────────────────────────────────────
# Comma-separated CIDR blocks for campus IP whitelisting
# Leave empty to disable network lock in development
ALLOWED_CIDR_BLOCKS=""

# Enable/disable exam session IP lock (true in production)
EXAM_IP_LOCK_ENABLED="false"
